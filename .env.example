# Select the active role models in config/models.yaml. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Vertex AI normally uses Application Default Credentials, not a committed key.
GOOGLE_APPLICATION_CREDENTIALS=

# SEC asks automated clients to identify a contact. Use a dedicated project email.
SEC_USER_AGENT=AgenticAlphaWorkbench/0.1 research-contact@example.com

# Development-only daily OHLCV adapter; keep the actual key in ignored .env.
ALPHAVANTAGE_API_KEY=

# Provider-neutral discovery adapter. The initial backend is Tavily.
TAVILY_API_KEY=

# Local runtime defaults. These services bind to localhost only.
POSTGRES_DB=alpha
POSTGRES_USER=alpha
POSTGRES_PASSWORD=alpha-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=5173
DATABASE_URL=postgresql://alpha:alpha-local-only@127.0.0.1:5432/alpha
REDIS_URL=redis://127.0.0.1:6379/0
ALPHA_JOB_QUEUE=alpha:jobs
